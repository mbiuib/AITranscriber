# ============================================================
# Whisper Transcriber — настройки по умолчанию
# Runtime-переопределения хранятся в data/settings.json
# ============================================================

# ---------- HuggingFace ----------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TRANSFER=true
HF_DOWNLOAD_TIMEOUT=30
HF_SYMLINKS_WARNING=false
HF_TELEMETRY=false

# ---------- Пути ----------
MODELS_DIR=G:\LLMs\models
DATA_DIR=data

# ---------- Сервер ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=*

# ---------- Whisper: значения по умолчанию ----------
DEFAULT_MODEL=large-v3
DEFAULT_LANGUAGE=ru
DEFAULT_BATCH_SIZE=8
DEFAULT_VAD=true
DEFAULT_COMPUTE_TYPE=float16
DEFAULT_DEVICE=cuda
DEFAULT_BEAM_SIZE=5
DEFAULT_CONDITION_ON_PREVIOUS=true

# Промпт для смешанной речи (русский + английские термины)
DEFAULT_INITIAL_PROMPT=Это совещание на русском языке. Используются технические термины на английском: Kubernetes, Docker, REST API, CI/CD, JavaScript, Python, SQL, GPU, CPU, API.

# ---------- Диаризация спикеров ----------
# Требует HF_TOKEN с принятыми условиями:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
DIARIZATION_ENABLED=false
DIARIZATION_MIN_SPEAKERS=0
DIARIZATION_MAX_SPEAKERS=0

# ---------- Лимиты ----------
MAX_UPLOAD_MB=4096
MAX_WORKERS=4

# ---------- Очистка ----------
# Через сколько часов удалять завершённые задачи и их файлы
RETENTION_HOURS=24
# Период фоновой очистки, минуты
CLEANUP_INTERVAL_MIN=30

# ---------- UI ----------
DEFAULT_UI_LANGUAGE=ru
DEFAULT_UI_THEME=dark

# ---------- MOSS-Transcribe-Diarize ----------
# Размер чанка в секундах. 300 (5 мин) — безопасно для 16 ГБ VRAM.
# Уменьшите до 180 при 8 ГБ, увеличьте до 600 при 24+ ГБ.
MOSS_CHUNK_DURATION=300

# Перехлёст между соседними чанками в секундах. Устраняет потерю слов
# на границах. 2 секунды — баланс между скоростью и качеством.
MOSS_CHUNK_OVERLAP=2

# Максимум токенов текста на один чанк.
# 4096 достаточно для 5-минутного фрагмента.
MOSS_MAX_NEW_TOKENS=4096

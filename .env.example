# ============================================================
# Whisper Transcriber — конфигурация
# Скопируйте этот файл в .env и заполните своими значениями.
# ============================================================

# ---------- HuggingFace ----------
# Токен доступа: https://huggingface.co/settings/tokens (тип Read)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ускорение скачивания через hf_transfer (pip install hf_transfer)
HF_TRANSFER=true

# Таймаут запросов к HF, секунд
HF_DOWNLOAD_TIMEOUT=30

# Отключить предупреждение о симлинках (актуально для Windows)
HF_SYMLINKS_WARNING=false

# Отключить телеметрию HF
HF_TELEMETRY=false

# ---------- Пути ----------
# Куда складывать модели: <MODELS_DIR>/<издатель>/<репозиторий>/
MODELS_DIR=G:\LLMs\models

# Куда сохранять загруженные файлы (относительно корня проекта или абсолютный путь)
UPLOAD_DIR=uploads

# ---------- Сервер ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# CORS: список origins через запятую, или * для всех
CORS_ORIGINS=*

# ---------- Whisper ----------
DEFAULT_MODEL=large-v3
DEFAULT_LANGUAGE=auto
DEFAULT_BATCH_SIZE=8
DEFAULT_VAD=true
DEFAULT_COMPUTE_TYPE=float16
DEFAULT_DEVICE=cuda

# ---------- Лимиты ----------
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=4096

# Параллельных HTTP-загрузок при скачивании модели
MAX_WORKERS=4
